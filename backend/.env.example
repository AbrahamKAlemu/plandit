DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Authenticated TikTok evidence adapter
ENSEMBLEDATA_ENABLED=0
ENSEMBLEDATA_API_TOKEN=
SOCIAL_EVIDENCE_THROTTLE_RATE=30/day

# Accounts and usage metrics
