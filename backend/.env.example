DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=

# Public-page caption extraction. Keep disabled until the deployment owner accepts
# the platform-policy and reliability tradeoffs documented in the feature dossier.
SOCIAL_PAGE_EXTRACTION_ENABLED=0

# Optional paid TikTok fallback
ENSEMBLEDATA_ENABLED=0
ENSEMBLEDATA_API_TOKEN=
SOCIAL_EVIDENCE_THROTTLE_RATE=100/day

# Accounts and usage metrics
# Supabase service-role key (Project Settings -> API keys, secret). Needed to delete auth users.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for GET /api/metrics/. Empty turns the endpoint off.
METRICS_API_KEY=
